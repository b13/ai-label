{
    "name": "b13/ai-label",
    "type": "typo3-cms-extension",
    "description": "AI Label / Flags backend records as AI-created / AI-modified.",
    "license": "GPL-2.0-or-later",
    "require": {
        "typo3/cms-backend": "^13.4 || ^14.3",
        "typo3/cms-frontend": "^13.4 || ^14.3"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "typo3/testing-framework": "^9",
        "phpstan/phpstan": "^2.1",
        "typo3/coding-standards": "^0.5.5",
        "typo3/cms-workspaces": "^13.4 || ^14.3",
        "typo3/cms-filelist": "^13.4 || ^14.3"
    },
    "config": {
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin",
        "allow-plugins": {
            "typo3/cms-composer-installers": true,
            "typo3/class-alias-loader": true
        }
    },
    "autoload-dev": {
        "psr-4": {
            "B13\\AiLabel\\Tests\\": "Tests"
        }
    },
    "autoload": {
        "psr-4": {
            "B13\\AiLabel\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "web-dir": ".Build/Web",
            "app-dir": ".Build",
            "extension-key": "ai_label",
            "version": "0.0.1",
            "Package": {
                "providesPackages": {}
            }
        }
    }
}
